# 루트 .env.local에 아래 네이버 항목을 직접 추가하세요.
# Neon이 관리하는 기존 DATABASE_URL 등은 지우거나 덮어쓰지 마세요.
# 서버 전용: 실제 값은 채팅, Git, VITE_* 환경변수에 넣지 않습니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 등록한 애플리케이션 유형에 맞게 선택: SELF 또는 SELLER
NAVER_AUTH_TYPE=
# SELLER 유형일 때만 해당 판매자 ID/UID 설정
NAVER_ACCOUNT_ID=
# DB에서 동일 스토어를 식별할 고정 키(비밀값 아님). 최초 저장 후 임의 변경 금지.
NAVER_STORE_KEY=lumette
