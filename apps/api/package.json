{
  "name": "@lumette/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "naver:check": "node dist/naver/diagnose.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@lumette/database": "workspace:*",
    "@lumette/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
